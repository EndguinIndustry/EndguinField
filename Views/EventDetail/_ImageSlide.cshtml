@model EventDetailViewModel

@{
	var images = Model?.Images ?? new List<string>();
}

<div id="eventImageSlide" class="imageSlide slide">
	@if (images.Any())
	{
		<div id="eventImageSlideInner" class="imageSlide-inner">
			@for (int i = 0; i < images.Count; i++)
			{
				<div class="imageSlide-item @(i == 0 ? "active" : "")">
					<img src="@images[i]" class="d-block w-100 rounded-3" alt="Event image @(i + 1)">
				</div>
			}
		</div>

		@if (images.Count > 1)
		{
			<button id="imageSlidePrevBtn" class="Btn"></button>
			<button id="imageSlideNextBtn" class="Btn"></button>
		}
	}
	else
	{
		<div class=" imageSlide-inner">
			<div class="imageSlide-item active">
				<div class="preview-image-placeholder">
					<span>No images available</span>
				</div>
			</div>
		</div>
	}
</div>

<script>
	const prevButton = document.querySelector('#imageSlidePrevBtn');
	const nextButton = document.querySelector('#imageSlideNextBtn');

	if (prevButton) {
		prevButton.addEventListener('click', () => {
			const inner = document.querySelector('#eventImageSlideInner');
			if (inner) {
				inner.scrollBy({ left: -inner.offsetWidth, behavior: 'smooth' });
			}
		});
	}

	if (nextButton) {
		nextButton.addEventListener('click', () => {
			const inner = document.querySelector('#eventImageSlideInner');
			if (inner) {
				inner.scrollBy({ left: inner.offsetWidth, behavior: 'smooth' });
			}
		});
	}
</script>