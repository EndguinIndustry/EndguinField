@model EventDetailViewModel

@{
	var description = Model?.Description ?? "No description provided.";
	var location = Model?.Location ?? "No location specified.";

	var startEdit = Model?.StartTime.ToString("yyyy-MM-ddTHH:mm") ?? "";
	var endEdit = Model?.EndTime.ToString("yyyy-MM-ddTHH:mm") ?? "";

	var formattedStart = Model?.StartTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";
	var formattedEnd = Model?.EndTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";
}

<div id="detailsSection">
	<div class="mb-3">
		<h2>Details</h2>
		<p id="viewDescription" class="ms-3 details-text">@description</p>
		<textarea id="editDescriptionInput" class="form-control ms-3 edit-mode-only" rows="5">@description</textarea>
	</div>

	<div class="mb-3">
		<h2>Location</h2>
		<p id="viewLocation" class="ms-3 details-text">@location</p>
		<input type="text" id="editLocationInput" class="form-control ms-3 edit-mode-only" value="@location" />
	</div>

	<div class="mb-3">
		<h2>Date</h2>
		<div id="viewDate">
			<p class="ms-3">@formattedStart - @formattedEnd</p>
		</div>
		<div class="edit-mode-only ms-3">
			<input type="datetime-local" id="editStartTimeInput" class="form-control mb-2" value="@startEdit" />
			<input type="datetime-local" id="editEndTimeInput" class="form-control" value="@endEdit" />
		</div>
	</div>
</div>