@model EventDetailViewModel

@{
    var eventName = Model?.Name ?? "Untitled Event";
}

<div class="event-header">
    <div class="event-title-wrapper">
        <h1 id="viewName">@eventName</h1>
        <input type="text" id="editNameInput" class="form-control form-control-lg edit-mode-only" value="@eventName" />
    </div>
    <div class="event-header-actions">
        @if (Model.IsOwner)
        {
            <button id="editBtn" class="btn btn-outline-secondary" type="button">Edit Event</button>
        }
        <button id="toggleBtn" class="btn btn-primary" type="button">Show Comments</button>
    </div>
</div>