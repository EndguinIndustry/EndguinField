@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<style>
    .dashboard-events {
        display: grid;
        grid-template-columns: 30% 1fr;
        gap: 2vw;

        width: 100%;
        margin: auto;
    }

    .left-panel {
        border: 1px solid lightgray;
        border-radius: 20px;
        padding: 1vw;
    }

    .right-panel {
        border: 1px solid lightgray;
        border-radius: 20px;
        padding: 1vw;
    }

    .switch-buttons {
        display: flex;
        justify-content: center;
        gap: 0.5vw;
        margin-bottom: 1vw;
    }

    .switch-buttons button {
        border: none;
        padding: 0.5vw 1vw;
        border-radius: 20px;
        background: #e5e5e5;
        cursor: pointer;
    }

    .switch-buttons button.active {
        background: #cfcfcf;
    }

    .event-panel {
        display: none;
    }

    .event-panel.active {
        display: block;
    }
</style>


@if (User?.Identity?.IsAuthenticated == true)
{

    <div class="dashboard-events">

        <div class="left-panel">

            <div class="switch-buttons">
                <button id="btn-pending" class="active" onclick="showPanel('pending')">Pending</button>
                <button id="btn-participating" onclick="showPanel('participating')">Participating</button>
                <button id="btn-ongoing" onclick="showPanel('ongoing')">My Ongoing</button>
            </div>


            <div id="pending" class="event-panel active">
                @if (Model?.PendingEvents != null)
                {
                    <partial name="_EventList" model="Model.PendingEvents" />
                }
                else
                {
                    <p>No pending events.</p>
                }
            </div>


            <div id="participating" class="event-panel">
                @if (Model?.ParticipatingEvents != null)
                {
                    <partial name="_EventList" model="Model.ParticipatingEvents" />
                }
                else
                {
                    <p>No participating events.</p>
                }
            </div>


            <div id="ongoing" class="event-panel">
                @if (Model?.MyOngoingEvents != null)
                {
                    <partial name="_EventList" model="Model.MyOngoingEvents" />
                }
                else
                {
                    <p>No ongoing events.</p>
                }
            </div>

        </div>

        <div class="right-panel">

            <h2 style="text-align:center;">Currently Open Events</h2>

            @if (Model?.OpenEvents != null)
            {
                <partial name="_EventList" model="Model.OpenEvents" />
            }
            else
            {
                <p>No open events.</p>
            }

        </div>

    </div>

}
else
{
    <script>
        window.location.href = '/Login/Index';
    </script>
}



<script>

    function showPanel(panel) {

        document.querySelectorAll(".event-panel").forEach(p => {
            p.classList.remove("active")
        })

        document.querySelectorAll(".switch-buttons button").forEach(b => {
            b.classList.remove("active")
        })

        document.getElementById(panel).classList.add("active")
        document.getElementById("btn-" + panel).classList.add("active")

    }

</script>