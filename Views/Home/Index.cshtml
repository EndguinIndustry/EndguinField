@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<style>
    .dashboard-events {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2vw;
        width: 100%;
        margin: auto;
    }

    .mobile-panel {
        display: grid;
        justify-content: center;
        min-width: max-content;
        border: 1px solid lightgray;
        border-radius: 20px;
        padding: 1vw;
    }

    .left-panel {
        display: grid;
        justify-content: center;
        min-width: max-content;
        border: 1px solid lightgray;
        border-radius: 20px;
        padding: 1vw;
    }

    .right-panel {
        min-width: max-content;
        border: 1px solid lightgray;
        border-radius: 20px;
        padding: 1vw;
    }

    .switch-buttons {
        display: flex;
        flex-wrap: wrap;
        width: 100%;
        align-items: center;
        gap: 0.5vw;
        margin-bottom: 1vw;
    }

    .switch-buttons button {
        border: none;
        padding: 0.5vw 1vw;
        border-radius: 20px;
        background: #e5e5e5;
        cursor: pointer;
    }

    .mobile-panel {
        display: none;
    }

    .switch-buttons button.active {
        background: #cfcfcf;
    }

    .event-panel {
        display: none;
    }

    .event-panel.active {
        display: block;
    }

    @@media (max-width: 500px) {
        .mobile-panel {
            display: block;
        }

        .left-panel {
            display: none;
        }

        .right-panel {
            display: none;
        }
    }
</style>

@if (User?.Identity?.IsAuthenticated == true)
{

    <div class="dashboard-events">

        <div class="mobile-panel">

            <div class="switch-buttons">

                <button id="btn-open-mobile" class="active" onclick="showPanel('mobile','open')">Open Events</button>
                <button id="btn-pending-mobile" onclick="showPanel('mobile','pending')">Pending</button>
                <button id="btn-participating-mobile" onclick="showPanel('mobile','participating')">Participating</button>
                <button id="btn-ongoing-mobile" onclick="showPanel('mobile','ongoing')">My Ongoing</button>

            </div>


            <div id="open-mobile" class="event-panel mobile-view active">
                @if (Model?.OpenEvents != null)
                {
                    <partial name="_EventList" model="Model.OpenEvents" />
                }
            </div>


            <div id="pending-mobile" class="event-panel mobile-view">
                @if (Model?.PendingEvents != null)
                {
                    <partial name="_EventList" model="Model.PendingEvents" />
                }
            </div>


            <div id="participating-mobile" class="event-panel mobile-view">
                @if (Model?.ParticipatingEvents != null)
                {
                    <partial name="_EventList" model="Model.ParticipatingEvents" />
                }
            </div>


            <div id="ongoing-mobile" class="event-panel mobile-view">
                @if (Model?.MyOngoingEvents != null)
                {
                    <partial name="_EventList" model="Model.MyOngoingEvents" />
                }
            </div>

        </div>


        <div class="left-panel">

            <div class="switch-buttons">

                <button id="btn-pending-desktop" class="active" onclick="showPanel('desktop','pending')">Pending</button>
                <button id="btn-participating-desktop" onclick="showPanel('desktop','participating')">Participating</button>
                <button id="btn-ongoing-desktop" onclick="showPanel('desktop','ongoing')">My Ongoing</button>

            </div>


            <div id="pending-desktop" class="event-panel desktop-view active">
                @if (Model?.PendingEvents != null)
                {
                    <partial name="_EventList" model="Model.PendingEvents" />
                }
            </div>


            <div id="participating-desktop" class="event-panel desktop-view">
                @if (Model?.ParticipatingEvents != null)
                {
                    <partial name="_EventList" model="Model.ParticipatingEvents" />
                }
            </div>


            <div id="ongoing-desktop" class="event-panel desktop-view">
                @if (Model?.MyOngoingEvents != null)
                {
                    <partial name="_EventList" model="Model.MyOngoingEvents" />
                }
            </div>

        </div>


        <div class="right-panel">

            <h2 style="text-align:center;">Currently Open Events</h2>

            @if (Model?.OpenEvents != null)
            {
                <partial name="_EventList" model="Model.OpenEvents" />
            }

        </div>

    </div>

}
else
{
    <script>
        window.location.href = '/Login/Index';
    </script>
}

<script>

    function showPanel(group, panel) {

        if (group === "mobile") {

            document.querySelectorAll(".mobile-view").forEach(p => p.classList.remove("active"))
            document.querySelectorAll("#btn-open-mobile,#btn-pending-mobile,#btn-participating-mobile,#btn-ongoing-mobile")
                .forEach(b => b.classList.remove("active"))

            document.getElementById(panel + "-mobile").classList.add("active")
            document.getElementById("btn-" + panel + "-mobile").classList.add("active")

        }

        if (group === "desktop") {

            document.querySelectorAll(".desktop-view").forEach(p => p.classList.remove("active"))
            document.querySelectorAll("#btn-pending-desktop,#btn-participating-desktop,#btn-ongoing-desktop")
                .forEach(b => b.classList.remove("active"))

            document.getElementById(panel + "-desktop").classList.add("active")
            document.getElementById("btn-" + panel + "-desktop").classList.add("active")

        }

    }

</script>