@model List<EndguinField.Models.Tag>

@{
    ViewData["Title"] = "Manage Tags";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<style>
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
  tr:hover { background-color: #f1f1f1; }
  
  .add-tag-form { display: flex; gap: 10px; margin-bottom: 20px; align-items: flex-end; }
  .add-tag-form .form-group { flex: 1; }
  .add-tag-form label { display: block; margin-bottom: 5px; font-weight: bold; }
  .add-tag-form input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; }
  .add-tag-form button { padding: 10px 20px; background: var(--admin-primary, #007bff); color: white; border: none; border-radius: 4px; cursor: pointer; height: 42px; }
  .add-tag-form button:hover { opacity: 0.9; }

  .badge-tag { display: inline-block; padding: 5px 10px; background-color: #e0e0e0; border-radius: 20px; font-size: 0.9em; margin-right: 5px; }
  
  .action-btn { padding: 5px 10px; border: none; border-radius: 4px; color: white; cursor: pointer; text-decoration: none; font-size: 0.9em; }
  .btn-danger { background-color: #dc3545; }
  .btn-danger:hover { background-color: #c82333; }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1>Manage Tags</h1>
        <a href="@Url.Action("Index", "Admin")" class="admin-btn btn-outline">&larr; Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 4px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 4px; margin-bottom: 20px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <h3>Add New Tag</h3>
        <form asp-action="CreateTag" method="post" class="add-tag-form">
            <div class="form-group">
                <label for="tagName">Tag Name</label>
                <input type="text" name="tagName" id="tagName" required placeholder="Enter tag name..." />
            </div>
            <button type="submit">Add Tag</button>
        </form>
    </div>

    <div class="admin-card">
        <h3>Existing Tags (@Model.Count)</h3>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="width: 70%;">Tag Name</th>
                        <th style="width: 30%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var tag in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge-tag">@tag.TagName</span>
                                </td>
                                <td>
                                    <form asp-action="DeleteTag" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this tag?');">
                                        <input type="hidden" name="id" value="@tag.Id" />
                                        <button type="submit" class="action-btn btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" style="text-align: center; color: #666;">No tags found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
