@model List<EndguinField.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<style>
  /* Local overrides for table responsiveness without external frameworks */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
  tr:hover { background-color: #f1f1f1; }
  
  .search-form { display: flex; gap: 10px; margin-bottom: 20px; }
  .search-form input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 4px; }
  .search-form button { padding: 10px 20px; background: var(--admin-primary); color: white; border: none; border-radius: 4px; cursor: pointer; }
  
  .badge { display: inline-block; padding: 4px 8px; font-size: 12px; font-weight: bold; border-radius: 4px; }
  .bg-open { background-color: #28a745; color: white; }
  .bg-closed { background-color: #6c757d; color: white; }
  .bg-cancelled { background-color: #dc3545; color: white; }

  .actions { display: flex; gap: 5px; flex-wrap: wrap; }
  .btn-sm { padding: 5px 10px; font-size: 12px; border-radius: 3px; cursor: pointer; border: 1px solid transparent; }
  .btn-primary { background-color: var(--admin-primary); color: white; }
  
  .event-image {
      width: 60px;
      height: 40px;
      object-fit: cover;
      border-radius: 4px;
      background-color: #eee;
  }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Event Management</h1>
        <a href="@Url.Action("Index", "Admin")" class="admin-btn btn-outline" style="text-decoration:none;">&larr; Back to Dashboard</a>
    </div>

    <form method="get" action="@Url.Action("Events", "Admin")" class="search-form">
        <input type="text" name="search" placeholder="Search by name or description..." value="@ViewBag.CurrentSearch">
        <select name="status" style="padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            <option value="">All Statuses</option>
            <option value="Open" asp-selected="@(ViewBag.CurrentStatus == "Open")">Open</option>
            <option value="Closed" asp-selected="@(ViewBag.CurrentStatus == "Closed")">Closed</option>
            <option value="Cancelled" asp-selected="@(ViewBag.CurrentStatus == "Cancelled")">Cancelled</option>
        </select>
        <button type="submit">Filter</button>
    </form>

    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th style="width: 80px;">Image</th>
                    <th>Name / Location</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Participants</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in Model)
                {
                    <tr>
                        <td>
                            @if (evt.Images != null && evt.Images.Any())
                            {
                                <img src="@evt.Images.First()" alt="@evt.Name" class="event-image">
                            }
                            else if (!string.IsNullOrEmpty(evt.BackgroundImage))
                            {
                                <img src="@evt.BackgroundImage" alt="@evt.Name" class="event-image">
                            }
                            else
                            {
                                <div class="event-image" style="display: flex; align-items: center; justify-content: center; color: #999;">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-weight: bold;">@evt.Name</div>
                            <div style="font-size: 0.85em; color: #666;">@evt.Location</div>
                        </td>
                        <td>
                            <div>@evt.StartTime.ToString("MMM dd, yyyy")</div>
                            <div style="font-size: 0.85em; color: #666;">@evt.StartTime.ToString("HH:mm") - @evt.EndTime.ToString("HH:mm")</div>
                        </td>
                        <td>
                            @{
                                var statusClass = "bg-secondary";
                                if (evt.Status == "Open") statusClass = "bg-open";
                                else if (evt.Status == "Closed") statusClass = "bg-closed";
                                else if (evt.Status == "Cancelled") statusClass = "bg-cancelled";
                            }
                            <span class="badge @statusClass">@evt.Status</span>
                        </td>
                        <td>
                            @evt.Participants.Count / @evt.MaxParticipants
                        </td>
                        <td>
                            <div class="actions">
                                <a href="@Url.Action("Index", "Event", new { id = evt.Id })" target="_blank" class="btn-sm btn-primary" style="text-decoration: none;">View</a>
                                
                                @if (evt.Status == "Open")
                                {
                                    <form method="post" action="@Url.Action("CancelEvent", "Admin")" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel this event?');">
                                        <input type="hidden" name="id" value="@evt.Id" />
                                        <button type="submit" class="btn-sm" style="color: #ffc107; border: 1px solid #ffc107; background: none;">Cancel</button>
                                    </form>
                                }

                                <form method="post" action="@Url.Action("DeleteEvent", "Admin")" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this event? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@evt.Id" />
                                    <button type="submit" class="btn-sm" style="color: red; border: 1px solid red; background: none;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
