@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Dashboard</h1>
        <span class="admin-badge">User: @User.Identity?.Name</span>
    </div>

    <div class="admin-grid">
        <div class="admin-card stat-card">
            <div class="stat-content">
                <h3>Total Users</h3>
                <p class="stat-number">@ViewBag.UserCount</p>
                <div class="action-buttons" style="margin-top: 1rem;">
                    <a href="@Url.Action("Users", "Admin")" class="admin-btn btn-primary" style="display: block; text-align: center;">Manage Users</a>
                </div>
            </div>
            <div class="stat-icon">👤</div>
        </div>

        <div class="admin-card stat-card">
            <div class="stat-content">
                <h3>Total Events</h3>
                <p class="stat-number">@ViewBag.EventCount</p>
                <div class="action-buttons" style="margin-top: 1rem;">
                    <a href="@Url.Action("Events", "Admin")" class="admin-btn btn-success" style="display: block; text-align: center;">Manage Events</a>
                </div>
            </div>
             <div class="stat-icon">📅</div>
        </div>

    </div>

    @* <div class="admin-card">
        <h3>Quick Actions</h3>
