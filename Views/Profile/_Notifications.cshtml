@model EndguinField.Models.ProfileViewModel

<div class="card p-3 mb-3">
    <h4>Notifications</h4>
    @if (Model.Notifications != null && Model.Notifications.Any())
    {
        <div class="list-group list-group-flush">
            @foreach (var notification in Model.Notifications)
            {
                <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-light")" id="notification-@notification.Id">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <small class="text-muted">@notification.CreatedAt.ToLocalTime().ToString("g")</small>
                        @if (!notification.IsRead)
                        {
                            <span class="badge bg-primary rounded-pill">New</span>
                        }
                    </div>
                    <p class="mb-1">@notification.Detail</p>
                    @if (!notification.IsRead)
                    {
                        <button class="btn btn-sm btn-link text-decoration-none p-0 mark-read-btn" onclick="markAsRead('@notification.Id')">Mark as read</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No notifications.</p>
    }
</div>

<script>
    async function markAsRead(id) {
        try {
            const response = await fetch(`/api/Notification/${id}/read`, { method: 'POST' });
            if (response.ok) {
                const element = document.getElementById(`notification-${id}`);
                if (element) {
                    element.classList.remove('list-group-item-light');
                    const badge = element.querySelector('.badge');
                    if (badge) badge.remove();
                    const btn = element.querySelector('.mark-read-btn');
                    if (btn) btn.remove();
                }
            }
        } catch (error) {
            console.error('Error marking notification as read:', error);
        }
    }
</script>
