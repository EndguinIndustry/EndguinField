@model ProfileViewModel


@if (Model.IsOwnProfile)
{
    <div class="friend-request-component" id="friendRequestPanel">
        <div class="friend-request-box">

            <div class="request-header">
                <h3>Friend Requests</h3>
                <button class="close-friendlist-btn" onclick="toggleFriendRequest(false)">✕</button>
            </div>

            <div class="request-list">

                @if (Model.PendingRequests != null && Model.PendingRequests.Any())
                {
                    @foreach (var req in Model.PendingRequests)
                    {
                        <div class="request-card">
                            <div class="request-identity">
                                @if (!string.IsNullOrEmpty(req.ImageUrl))
                                {
                                    <img class="avatar" src="@req.ImageUrl" />
                                }
                                else
                                {
                                    <div class="avatar-tmp">
                                        <span>@req.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                }
                                <a href="/Profile/View/@req.Id" style="color: black; text-decoration: none;">
                                    <span class="username">@req.Name</span>
                                </a>
                            </div>



                            <div class="request-actions">
                                <button class="accept-btn" onclick="handleFriendRequest('@req.Id', true)">
                                    ✓
                                </button>
                                <button class="reject-btn" onclick="handleFriendRequest('@req.Id', false)">
                                    ✕
                                </button>
                            </div>
                        </div>

                    }
                }
                else
                {
                    <div class="no-requests">
                        <p>No pending friend requests</p>
                    </div>
                }
            </div>
        </div>
    </div>
}