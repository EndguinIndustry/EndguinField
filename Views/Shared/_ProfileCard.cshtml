@model EndguinField.Models.ProfileViewModel

<div class="profile-card @(Model.IsBanned ? "profile-banned" : "")">
    @if (Model.IsBanned)
    {
        <div class="ban-notice">
            <span>Account Banned Until: @Model.BanUntil?.ToString("MMM dd, yyyy")</span>
        </div>
    }
    
    <div class="profile-card-header">
        <div class="profile-avatar">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="avatar-image">
            }
            else
            {
                <div class="avatar-placeholder">
                    <span>@Model.Name.Substring(0, 1).ToUpper()</span>
                </div>
            }
            <span class="joined-date">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Joined: @Model.JoinedDate
            </span>
        </div>
        <div class="profile-info">
            <h2 class="profile-name">@Model.Name</h2>
            <div class="profile-details">
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <span class="detail-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        @Model.Email
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.Contact))
                {
                    <span class="detail-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        @Model.Contact
                    </span>
                }
            </div>
        </div>
        <button class="edit-button" onclick="editProfile(@Model.Id)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
        </button>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.Bio))
    {
        <div class="profile-bio">
            <p>@Model.Bio</p>
        </div>
    }
    
    @* <div class="profile-stats">
        <div class="stat-item">
            <div class="stat-value">@Model.FriendsCount</div>
            <div class="stat-label">Friends</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@Model.EnrollsCount</div>
            <div class="stat-label">Events</div>
        </div>
        @if (Model.PendingFriendRequests > 0)
        {
            <div class="stat-item stat-highlighted">
                <div class="stat-value">@Model.PendingFriendRequests</div>
                <div class="stat-label">Pending Requests</div>
            </div>
        }
    </div> *@
    
    @* <div class="profile-footer">
        <span class="joined-date">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Joined: @Model.JoinedDate
        </span>
    </div> *@
</div>