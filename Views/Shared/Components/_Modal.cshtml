<div id="app-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
        <div class="modal-header">
            <span id="modal-title" class="modal-title"></span>
            <button class="modal-close-btn" id="modal-close-btn" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <p id="modal-message"></p>
        </div>
        <div class="modal-footer" id="modal-footer">
            <button class="btn btn-primary" id="modal-confirm-btn">OK</button>
            <button class="btn btn-outline-secondary" id="modal-cancel-btn">Cancel</button>
        </div>
    </div>
</div>
