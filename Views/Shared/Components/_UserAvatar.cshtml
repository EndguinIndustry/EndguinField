@model EndguinField.Models.ViewModels.Components.UserAvatarViewModel

@{
    var name = string.IsNullOrWhiteSpace(Model.Name) ? "U" : Model.Name;
    var alt = string.IsNullOrWhiteSpace(Model.AltText) ? name : Model.AltText;
}

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" alt="@alt" class="avatar-image @Model.CssClass" id="avatarPreview">
}
else
{
    <div class="avatar-placeholder @Model.CssClass" id="avatarPreview">
        <span id="avatarInitial">@name.Substring(0, 1).ToUpper()</span>
    </div>
}