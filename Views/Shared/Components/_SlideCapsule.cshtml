@model EndguinField.Models.ViewModels.SlideCapsuleViewModel

@{
    var selectedIndex = Model.Options.FindIndex(o => o.Value == Model.CurrentValue);
    if (selectedIndex < 0) selectedIndex = 0;
    var count = Model.Options.Count;
}

<div class="slide-capsule" data-group="@Model.GroupName">
    <div class="slide-capsule-track">
        <div class="slide-capsule-indicator"
             data-variant="@(Model.Options.Count > selectedIndex ? Model.Options[selectedIndex].Variant : "")">
        </div>
        @for (int i = 0; i < Model.Options.Count; i++)
        {
            var (value, variant) = Model.Options[i];
            var id = $"{Model.GroupName}_{value}";
            <input type="radio" class="slide-capsule-input" name="@Model.GroupName" id="@id"
                   value="@value" @(Model.CurrentValue == value ? "checked" : "") />
            <label class="slide-capsule-option" for="@id" data-variant="@variant" data-index="@i">@value</label>
        }
    </div>
</div>
