@model EndguinField.Models.EventModel

<style>
    div.EventCard {
        display: grid;
        row-gap: 0.01vh;
        max-width: 20vw;
        max-height: 32vh;
        background-color: rgb(255, 0, 191);
    }

    div.EventCard h1 {
        padding: 0.5vw;
        max-width: 20vw;
        font-size: 1.5vw;
        background-color: rgb(0, 35, 151);
    }

    div.EventCard img {
        background-color: rgb(255, 145, 0);
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-top-right-radius: 40px;
        border-top-left-radius: 40px;
    }

    div.EventCard p {
        padding: 0.25vw;
        font-size: 0.75vw;
        background-color: rgb(255, 0, 0)55, 145, 0);
    }

    a.EventLink {
        text-decoration: none;
        max-width: fit-content;
        color: inherit;
        display: block;
        background-color: rgb(0, 255, 255);
    }
</style>

<a class="EventLink"href="">
    <div class="EventCard">
        <img src="@Model.ImgSrc" alt="EventBanner">
        <h1>@Model.Name</h1>
        <p>Date: @Model.Date <br> Location: @Model.Location</p>
    </div>
</a>