@model EndguinField.Models.EventCardModel

<style>
    div.EventCard {
        margin: auto;
        width: 100%;
        height: fit-content;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid lightgray;
    }

    .EventImage {
        width: 100%;
        height: 150px;
        overflow: hidden;
    }

    .EventImage img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .CardInfo {
        display: flex;
        justify-content: space-between;
        padding: 10px;
    }

    .CardDetail {
        display: flex;
        flex-direction: column;
    }

    .EventCard h1 {
        justify-self: left;
        font-size: clamp(16px, 1.2vw, 22px);
        margin: 0;
    }

    .EventCard p {
        font-size: clamp(12px, 0.8vw, 14px);
    }

    a.EventLink {
        width: 250px;
        text-decoration: none;
        color: inherit;
    }
</style>

<a class="EventLink" href="/Event/@Model.Id" data-tags="@string.Join(",", Model.Tags ?? new List<string>())">
    <div class="EventCard">
        <div class="EventImage">
            <img src="@Model.ImgSrc" alt="EventBanner">
        </div>
        <div class="CardInfo">
            <div class="CardDetail">
                <h1>@Model.Name</h1>
                <p>Date: @Model.StartTime - @Model.EndTime <br> Location: @Model.Location</p>
            </div>
            <div class="Participant">
                <h1>@Model.ParticipantCount / @Model.MaxParticipants</h1>
            </div>
        </div>

    </div>
</a>