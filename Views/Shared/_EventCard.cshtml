@model EndguinField.Models.EventModel

<style>
    div.EventCard {
        border: 1px solid black;
        border-radius: 40px;
        display: grid;
        row-gap: 0.01vh;
        max-width: 30vw;
        max-height: fit-content;
    }

    div.EventCard h1 {
        padding: 0.5vw;
        max-width: 20vw;
        font-size: 1.5vw;
    }

    div.EventCard img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-top-right-radius: 40px;
        border-top-left-radius: 40px;
    }

    div.EventCard p {
        margin-left: 0.5vw;
        padding: 0.25vw;
        font-size: 0.75vw;
    }

    a.EventLink {
        text-decoration: none;
        max-width: fit-content;
        color: inherit;
        display: block;
    }

    div.CardInfo {
        column-gap: 2vw;
        align-items: center;
        display: flex;
        flex-direction: row;
    }

    div.CardDetail {
        display: flex;
        flex-direction: column;
    }
</style>

<a class="EventLink" href="">
    <div class="EventCard">
        <img src="@Model.ImgSrc" alt="EventBanner">
        <div class="CardInfo">
            <div class="CardDetail">
                <h1>@Model.Name</h1>
                <p>Date: @Model.Date <br> Location: @Model.Location</p>
            </div>
            <div class="Participant">
                <h1>1/8</h1>
            </div>
        </div>

    </div>
</a>