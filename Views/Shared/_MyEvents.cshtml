@model EndguinField.Models.ProfileViewModel

<style>
    div.history-section {
        width: 1000px;
        padding: 1vw;
        margin: 1vw;
        border-style: solid;
        border-color: lightgray;
        border-radius: 20px;
        overflow: hidden;
    }

    div.history-list {
        overflow-x: auto;
        display: flex;
        flex-direction: row;
        column-gap: 1vw;
        padding-bottom: 5px;
    }
</style>


<div class="history-section">
    <h2>My Events</h2>
    <div class="history-list">
        @if (Model.MyEvents != null && Model.MyEvents.Count > 0)
        {
            foreach (var eventCard in Model.MyEvents)
            {
                <partial name="_EventCard" model="eventCard" />
            }
        }
        else
        {
            <p>No my events to show.</p>
        }
    </div>
</div>