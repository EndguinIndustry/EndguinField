@model EndguinField.Models.ProfileViewModel

<style>
    .my-events-section {
        position: relative;
        max-width: 500px;
        width: 43%;
        padding: 1rem;
        margin: 1rem auto;
        border: 1px solid lightgray;
        border-radius: 20px;
        box-sizing: border-box;
    }

    .my-events-list {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 5px;
    }

    .my-events-list>* {
        flex: 0 0 260px;
    }

    .my-events-popup {
        display: none;
        position: fixed;
        z-index: 1000;
        inset: 0;

        background-color: rgba(0, 0, 0, 0.5);

        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

    .my-events-popup-content {
        display: grid;
        position: relative;
        background: white;

        padding: 1.5rem;

        width: min(900px, 95%);
        max-height: 85vh;

        border-radius: 20px;

        overflow-y: auto;
    }

    .my-events-popup-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        justify-items: center;
    }

    .close-my-events-btn {
        position: absolute;
        top: 10px;
        right: 16px;
        font-size: 30px;
        cursor: pointer;
    }

    .open-my-events-btn {
        font-size: 30px;
        position: absolute;
        top: 10px;
        right: 16px;
        cursor: pointer;
    }

    /* Mobile */
    @@media (max-width: 450px) {

        .my-events-section {
            width: 95%;
            padding: 1rem;
        }

        .my-events-list>* {
            flex: 0 0 80%;
        }

        .my-events-popup-content {
            width: 95%;
            max-height: 90vh;
        }

        .my-events-popup-list {
            grid-template-columns: 1fr;
        }

    }
</style>

<div id="myEventsPopup" class="my-events-popup">
    <div class="my-events-popup-content">
        <span class="close-my-events-btn" onclick="closeEventsPopup()">&times;</span>
        <h2>My Events</h2>

        <div class="my-events-popup-list">
            @if (Model.MyEvents != null && Model.MyEvents.Count > 0)
            {
                foreach (var eventCard in Model.MyEvents)
                {
                    <partial name="_EventCard" model="eventCard" />
                }
            }
            else
            {
                <p>No my events to show.</p>
            }
        </div>
    </div>
</div>


<div class="my-events-section">
    <h2>My Events</h2>
    <span class="open-my-events-btn" onclick="openEventsPopup()">⤢</span>
    <div class="my-events-list">
        @if (Model.MyEvents != null && Model.MyEvents.Count > 0)
        {
            foreach (var eventCard in Model.MyEvents)
            {
                <partial name="_EventCard" model="eventCard" />
            }
        }
        else
        {
            <p>No my events to show.</p>
        }
    </div>
</div>

<script>
    function openEventsPopup() {
        document.getElementById("myEventsPopup").style.display = "flex";
    }

    function closeEventsPopup() {
        document.getElementById("myEventsPopup").style.display = "none";
    }
</script>