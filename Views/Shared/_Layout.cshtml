<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EndguinField</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EndguinField.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

</head>

<body>
    <header>
        <nav class="navbar-custom">
            <a class="navbar-brand" href="/">EndguinField</a>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="search-input" placeholder="Search event">
                <i class="fa-solid fa-filter"></i>
            </div>
            <div class="profile-section">
                <img src="~/asset/profile.svg" alt="Profile Illustration" width="50px" />
            </div>
        </nav>
    </header>

    <div class="container" style="max-width: 1200px; margin: 20px auto; padding: 0 15px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        &copy; 2026 - EndguinField - <a href="/privacy" style="color: #8A2BE2; text-decoration: none;">Privacy</a>
    </footer>

    <partial name="_Modal" />
    <script src="~/js/slideCapsule.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modal.js" asp-append-version="true"></script>
</body>

</html>