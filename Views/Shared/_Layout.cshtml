<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EndguinField</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EndguinField.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

</head>

<body>
    <header>
        <nav class="navbar-custom">
            <a class="navbar-brand" href="/">EndguinField</a>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="search-input" placeholder="Search event">
                <i class="fa-solid fa-filter"></i>
            </div>
            <div class="profile-section">
                @if (ViewBag.CurrentUser != null)
                {
                    <a href="/Profile/@ViewBag.CurrentUser.Id" title="@ViewBag.CurrentUser.Name">
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentUser.Image))
                        {
                            <img src="@ViewBag.CurrentUser.Image" alt="@ViewBag.CurrentUser.Name" width="50px"
                                 style="border-radius: 50%; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/asset/profile.svg" alt="Profile Illustration" width="50px" />
                        }
                    </a>
                }
                else
                {
                    <a href="/Home/Login">
                        <button class="login">LOGIN</button>
                    </a>
                }
            </div>
        </nav>
    </header>

    <div class="container" style="max-width: 1200px; margin: 20px auto; padding: 0 15px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

</body>

</html>