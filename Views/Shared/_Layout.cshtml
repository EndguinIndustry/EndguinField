@using System.Security.Principal
@using System.Security.Claims
@inject EndguinField.Services.IUserService UserService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EndguinField</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EndguinField.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
</head>

<body>
    @{
        var profileImageUrl = Url.Content("~/asset/profile.svg");
        EndguinField.Models.User? currentUser = null;
        if (User.Identity?.IsAuthenticated == true)
        {
            var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!string.IsNullOrWhiteSpace(currentUserId))
            {
                currentUser = await UserService.GetUserByIdAsync(currentUserId);
                if (!string.IsNullOrWhiteSpace(currentUser?.Image))
                {
                    profileImageUrl = currentUser.Image;
                }
            }
        }
    }
    <header>
        <nav class="navbar-custom">
            <a class="navbar-brand" href="/">EndguinField</a>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="search-input" placeholder="Search event">
                <i class="fa-solid fa-filter"></i>
            </div>
            <div class="profile-section">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    <details class="profile-menu">
                        <summary class="profile-menu-trigger">
                            <img src="@profileImageUrl" alt="Profile" width="50px" />
                        </summary>
                        <div class="profile-menu-content">
                            <a href="/Profile" class="profile-menu-item">Profile</a>
                            @if (currentUser?.Role == "Admin")
                            {
                                <a href="/Admin" class="profile-menu-item">Admin Console</a>
                            }
                            <form asp-controller="Login" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="profile-menu-item profile-menu-button">Logout</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a href="/Login" class="profile-login-link">Login</a>
                }
            </div>
        </nav>
    </header>

    <div class="container" style="max-width: 1200px; margin: 20px auto; padding: 0 15px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        &copy; 2026 - EndguinField - <a href="/privacy" style="color: #8A2BE2; text-decoration: none;">Privacy</a>
    </footer>

    <partial name="Components/_Modal" />
    <script src="~/js/Shared/slideCapsule.js" asp-append-version="true"></script>
    <script type="module" src="~/js/Shared/modal.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const profileMenu = document.querySelector('.profile-menu');
            if (!profileMenu) {
                return;
            }

            document.addEventListener('click', function (event) {
                if (!profileMenu.contains(event.target)) {
                    profileMenu.removeAttribute('open');
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    profileMenu.removeAttribute('open');
                }
            });
        });
    </script>
</body>

</html>