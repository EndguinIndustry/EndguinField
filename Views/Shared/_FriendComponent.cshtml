@model ProfileViewModel

<div  class="friend-panel" id="friendListPanel">
<div class="friend-component">
    <div style="display: flex;">
        <h3>Friend List</h3>
        @if (Model.IsOwnProfile)
        {
            <button class="friend-request-button" onclick="toggleFriendRequest(true)">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                        <path
                        d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
                    </svg>

                    @if (Model.PendingRequests != null && Model.PendingRequests.Any())
                    {
                        <span class="notification-dot"></span>
                    }
                </div>
            </button>
        }
        <button class="close-friend-list-button" onclick="toggleFriendList(false)">
                <div class="icon-wrapper">
                    ✕
                </div>
            </button>
    </div>

    <partial name="_FriendList" model="Model" />
</div>
</div>



