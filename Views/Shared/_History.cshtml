@model EndguinField.Models.ProfileViewModel

<style>
    .history-section {
        position: relative;
        max-width: 400px;
        width: 43%;
        padding: 1rem;
        margin: 1rem auto;
        border: 1px solid lightgray;
        border-radius: 20px;
        box-sizing: border-box;
    }

    .history-list {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 5px;
    }

    .history-list>* {
        flex: 0 0 260px;
    }

    .open-history-btn {
        position: absolute;
        top: 10px;
        right: 16px;
        cursor: pointer;
    }

    .history-popup {
        display: none;
        position: fixed;
        z-index: 1000;
        inset: 0;

        background: rgba(0, 0, 0, 0.5);

        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

    .history-popup-content {
        background: white;
        padding: 1.5rem;

        width: min(900px, 95%);
        max-height: 85vh;

        border-radius: 20px;
        overflow-y: auto;
    }

    .history-popup-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        justify-items: center;
    }



    .history-popup-header {
        position: sticky;
        top: 0;
        background: white;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .open-history-btn {
        position: absolute;
        top: 10px;
        right: 16px;
        cursor: pointer;
        font-size: 30px;
    }

    .close-history-btn {
        position: absolute;
        top: 10px;
        right: 16px;
        cursor: pointer;
        font-size: 30px;
    }

    /* Mobile */
    @@media (max-width: 450px) {

        .history-section {
            width: 95%;
            padding: 1rem;
        }

        .history-list>* {
            flex: 0 0 80%;
        }

        .history-popup-content {
            width: 95%;
            max-height: 90vh;
        }

        .history-popup-list {
            grid-template-columns: 1fr;
        }


    }
</style>

<div id="historyPopup" class="history-popup">
    <div class="history-popup-content">

        <div class="history-popup-header">
            <h2>Past Events</h2>
            <span class="close-history-btn" onclick="closeHistoryPopup()">&times;</span>
        </div>

        <div class="history-popup-list">
            @if (Model.PastEvents != null && Model.PastEvents.Count > 0)
            {
                foreach (var eventCard in Model.PastEvents)
                {
                    <partial name="_EventCard" model="eventCard" />
                }
            }
            else
            {
                <p>No past events to show.</p>
            }
        </div>

    </div>
</div>


<div class="history-section">
    <h2>Past Events</h2>
    <span class="open-history-btn" onclick="openHistoryPopup()">⤢</span>
    <div class="history-list">
        @if (Model.PastEvents != null && Model.PastEvents.Count > 0)
        {
            foreach (var eventCard in Model.PastEvents)
            {
                <partial name="_EventCard" model="eventCard" />
            }
        }
        else
        {
            <p>No past events to show.</p>
        }
    </div>
</div>

<script>
    function openHistoryPopup() {
        document.getElementById("historyPopup").style.display = "flex";
    }

    function closeHistoryPopup() {
        document.getElementById("historyPopup").style.display = "none";
    }
</script>