@model EndguinField.Models.ProfileViewModel

<style>
    .history-section {
        position: relative;
        width: 25%;
        padding: 1vw;
        margin: 1vw auto;
        border: 1px solid lightgray;
        border-radius: 20px;
        box-sizing: border-box;
    }

    div.history-list {
        display: flex;
        gap: 1vw;

        overflow-x: auto;
        overflow-y: hidden;

        padding-bottom: 5px;
    }

    .history-list>* {
        flex: 0 0 260px;
    }

    .open-btn {
        position: absolute;
        top: 15px;
        right: 20px;
        cursor: pointer;
    }

    .events-popup {
        display: none;
        position: fixed;
        z-index: 1000;

        left: 0;
        top: 0;

        width: 100%;
        height: 100%;

        background: rgba(0, 0, 0, 0.5);

        justify-content: center;
        align-items: center;
    }

    .events-popup-content {
        background: white;
        padding: 2vw;

        width: 80%;
        max-height: 80vh;

        border-radius: 20px;
        overflow-y: auto;
    }

    .events-popup-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1vw;
    }

    .popup-header {
        position: sticky;
        top: 0;
        background: white;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .close-btn {
        font-size: 30px;
        cursor: pointer;
    }

    @@media (max-width: 1024px) {
        .history-section {
            width: 80%;
        }

        .events-popup-content {
            width: 90%;
        }

    }
</style>

<div id="historyPopup" class="events-popup">
    <div class="events-popup-content">

        <div class="popup-header">
            <h2>Past Events</h2>
            <span class="close-btn" onclick="closeHistoryPopup()">&times;</span>
        </div>

        <div class="events-popup-list">
            @if (Model.PastEvents != null && Model.PastEvents.Count > 0)
            {
                foreach (var eventCard in Model.PastEvents)
                {
                    <partial name="_EventCard" model="eventCard" />
                }
            }
            else
            {
                <p>No past events to show.</p>
            }
        </div>

    </div>
</div>


<div class="history-section">
    <h2>Past Events</h2>
    <button class="open-btn" onclick="openHistoryPopup()">Expand</button>
    <div class="history-list">
        @if (Model.PastEvents != null && Model.PastEvents.Count > 0)
        {
            foreach (var eventCard in Model.PastEvents)
            {
                <partial name="_EventCard" model="eventCard" />
            }
        }
        else
        {
            <p>No past events to show.</p>
        }
    </div>
</div>

<script>
    function openHistoryPopup() {
        document.getElementById("historyPopup").style.display = "flex";
    }

    function closeHistoryPopup() {
        document.getElementById("historyPopup").style.display = "none";
    }
</script>