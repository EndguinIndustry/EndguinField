@model IEnumerable<EndguinField.Models.EventCardModel>

<style>
    div.event-list-section {
        margin: auto;
        width: 100%;
        padding: 1vw;
        border-radius: 20px;
        box-sizing: border-box;
    }

    div.event-list {
        margin: auto;
        height: 32vw;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1.2vw;
    }
</style>

<div class="event-list-section">
    <div class="event-list">
        @if (Model != null && Model.Any())
        {
            foreach (EventCardModel item in Model)
            {
                <partial name="_EventCard" model="item" />
            }
        }
        else
        {
            <p>No events available.</p>
        }
    </div>
</div>