@model ProfileViewModel
<div style="position:relative; max-width:700px; min-height:200px; background-color:#FCECD6; margin:auto; border-radius:10px; border-style:solid; border-color:#000000; padding:15px;">
    @foreach (var friend in Model.Friends)
    {
        <partial name="_FriendEach" model="friend" />
    }
</div>