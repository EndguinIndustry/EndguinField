@{
    ViewData["Title"] = "Account Suspended";
    Layout = "_Layout";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg p-3 mb-5 bg-white rounded" style="max-width: 600px; margin: 0 auto;">
        <div class="card-body">
            <h1 class="display-4 text-danger mb-4"><i class="fas fa-ban"></i> Suspended</h1>
            <p class="lead">Your account has been suspended due to violations of our community guidelines.</p>
            
            @if (ViewBag.Until != null)
            {
                <div class="alert alert-warning" role="alert">
                    The suspension will be lifted on: <strong>@(((DateTime)ViewBag.Until).ToString("F"))</strong>
                </div>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    This account has been permanently suspended.
                </div>
            }
            
            <p class="mt-4">
                If you believe this is a mistake, please contact support.
            </p>
            
            <a href="/" class="btn btn-primary mt-3">Return to Home</a>
        </div>
    </div>
</div>
