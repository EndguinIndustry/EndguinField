@model EventViewModel
@inject ITagSchemaServices TagService

@{
	var description = Model?.Description ?? "No description provided.";
	var location = Model?.Location ?? "No location specified.";

	var startEditDate = Model?.StartTime.ToString("yyyy-MM-dd") ?? "";
	var startEditTime = Model?.StartTime.ToString("HH:mm") ?? "";
	var endEditDate = Model?.EndTime.ToString("yyyy-MM-dd") ?? "";
	var endEditTime = Model?.EndTime.ToString("HH:mm") ?? "";

	var formattedStart = Model?.StartTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";
	var formattedEnd = Model?.EndTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";

	var currentParticipantCount = Model?.ParticipationCount ?? 0;
}

<div id="detailsSection">
	@if (Model?.IsOwner == true && !Model.IsCreateMode)
	{
		<div class="mb-3 edit-mode-only">
			<h2>Status</h2>
			<div class="ms-3">
				<partial name="Components/_SlideCapsule" model='new SlideCapsuleViewModel {
					CurrentValue = Model.Status,
					GroupName = "eventStatus",
					Options = new() { ("Open", "success"), ("Closed", "danger"), ("Cancelled", "secondary") }
				}' />
			</div>
		</div>

	}

	<div class="mb-3 edit-mode-only">
		<h2>Max Participants</h2>
		<div class="ms-3">
			<input type="number" id="editMaxParticipantsInput" class="form-control"
				   value="@Model?.MaxParticipants"
				   min="@currentParticipantCount"
				   max="100" />
			@if (currentParticipantCount > 0)
			{
				<small class="text-muted">Min: @currentParticipantCount (current participants)</small>
			}
		</div>
	</div>

	<div class="mb-3">
		<h2>Tags</h2>
		<div class="view-mode-only">
			@if (Model?.Tags != null && Model.Tags.Any())
			{
				<div class="tags-view-container">
					@foreach (var tag in Model.Tags)
					{
						<span class="tag-chip">@tag</span>
					}
				</div>
			}
			else
			{
				<span class="text-muted details-text">No tags.</span>
			}
		</div>
		<div class="edit-mode-only event-tags-container">
			@{
				var dbTags = await TagService.GetAllAsync();
				var tagsList = dbTags.Select(t => t.TagName).ToList();
			}
			@foreach (var tag in tagsList)
			{
				bool isSelected = Model?.Tags?.Contains(tag) == true;
				<button type="button" class="btn badge rounded-pill event-tag-btn @(isSelected ? "bg-primary text-white selected" : "bg-secondary text-light")" data-tag-value="@tag">
					@tag
				</button>
			}
		</div>
	</div>

	<div class="mb-3">
		<h2>Details</h2>
		<p id="viewDescription" class="details-text view-mode-only">@description</p>
		<div class="edit-mode-only">
			<textarea id="editDescriptionInput" class="form-control" rows="5" maxlength="2000">@description</textarea>
			<div class="char-counter"><span id="descriptionCharCount">0</span>/2000</div>
		</div>
	</div>

	<div class="mb-3">
		<h2>Location</h2>
		<p id="viewLocation" class="details-text view-mode-only">@location</p>
		<div class="edit-mode-only">
			<textarea id="editLocationInput" class="form-control" rows="3" maxlength="500">@location</textarea>
			<div class="char-counter"><span id="locationCharCount">0</span>/500</div>
		</div>
	</div>

	<div class="mb-3">
		<h2>Date</h2>
		<div id="viewDate" class="view-mode-only">
			<div class="date-view-card">
				<div class="date-view-row">
					<img src="/assets/icons/calendar.svg" alt="start" class="date-view-icon icon-date" />
					<div class="date-view-info">
						<span class="date-view-label">Start</span>
						<span class="date-view-value">@formattedStart</span>
					</div>
				</div>
				<div class="date-view-divider"></div>
				<div class="date-view-row">
					<img src="/assets/icons/calendar.svg" alt="end" class="date-view-icon icon-date" />
					<div class="date-view-info">
						<span class="date-view-label">End</span>
						<span class="date-view-value">@formattedEnd</span>
					</div>
				</div>
			</div>
		</div>
		<div class="edit-mode-only">
			<label class="form-label fw-semibold">Start Date & Time</label>
			<div class="date-time-container mb-3">
				<div class="date-picker-overlay form-control mb-2">
					<span class="date-display">@(string.IsNullOrEmpty(startEditDate) ? "dd/mm/yyyy" : DateTime.Parse(startEditDate).ToString("dd/MM/yyyy"))</span>
					<img src="/assets/icons/calendar.svg" class="calendar-icon icon-dark" alt="calendar" />
					<input type="date" id="editStartDateInput" value="@startEditDate" />
				</div>
				<input type="time" id="editStartTimeInput" class="form-control time-input-edit" value="@startEditTime" />
			</div>
			
			<label class="form-label fw-semibold">End Date & Time</label>
			<div class="date-time-container mb-3">
				<div class="date-picker-overlay form-control mb-2">
					<span class="date-display">@(string.IsNullOrEmpty(endEditDate) ? "dd/mm/yyyy" : DateTime.Parse(endEditDate).ToString("dd/MM/yyyy"))</span>
					<img src="/assets/icons/calendar.svg" class="calendar-icon icon-dark" alt="calendar" />
					<input type="date" id="editEndDateInput" value="@endEditDate" />
				</div>
				<input type="time" id="editEndTimeInput" class="form-control time-input-edit" value="@endEditTime" />
			</div>
		</div>
	</div>


</div>