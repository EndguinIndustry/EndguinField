@model EventViewModel

@{
	var description = Model?.Description ?? "No description provided.";
	var location = Model?.Location ?? "No location specified.";

	var startEdit = Model?.StartTime.ToString("yyyy-MM-ddTHH:mm") ?? "";
	var endEdit = Model?.EndTime.ToString("yyyy-MM-ddTHH:mm") ?? "";

	var formattedStart = Model?.StartTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";
	var formattedEnd = Model?.EndTime.ToString("MMMM d, yyyy h:mm tt") ?? "N/A";

	var currentParticipantCount = Model?.ParticipationCount ?? 0;
}

<div id="detailsSection">
	@if (Model.IsOwner && !Model.IsCreateMode)
	{
		<div class="mb-3 edit-mode-only">
			<h2>Status</h2>
			<div class="ms-3">
				<partial name="Components/_SlideCapsule" model='new SlideCapsuleViewModel {
					CurrentValue = Model.Status,
					GroupName = "eventStatus",
					Options = new() { ("Open", "success"), ("Closed", "danger"), ("Cancelled", "secondary") }
				}' />
			</div>
		</div>

		<div class="mb-3 edit-mode-only">
			<h2>Max Participants</h2>
			<div class="ms-3">
				<input type="number" id="editMaxParticipantsInput" class="form-control"
					   value="@Model.MaxParticipants"
					   min="@currentParticipantCount"
					   max="1000" />
				@if (currentParticipantCount > 0)
				{
					<small class="text-muted">Min: @currentParticipantCount (current participants)</small>
				}
			</div>
		</div>
	}

	<div class="mb-3">
		<h2>Details</h2>
		<p id="viewDescription" class="ms-3 details-text">@description</p>
		<textarea id="editDescriptionInput" class="form-control ms-3 edit-mode-only" rows="5">@description</textarea>
	</div>

	<div class="mb-3">
		<h2>Location</h2>
		<p id="viewLocation" class="ms-3 details-text">@location</p>
		<input type="text" id="editLocationInput" class="form-control ms-3 edit-mode-only" value="@location" />
	</div>

	<div class="mb-3">
		<h2>Date</h2>
		<div id="viewDate">
			<p class="ms-3">@formattedStart - @formattedEnd</p>
		</div>
		<div class="edit-mode-only ms-3">
			<label class="form-label fw-semibold">Start Date</label>
			<input type="datetime-local" id="editStartTimeInput" class="form-control mb-3" value="@startEdit" />
			<label class="form-label fw-semibold">End Date</label>
			<input type="datetime-local" id="editEndTimeInput" class="form-control" value="@endEdit" />
		</div>
	</div>


</div>