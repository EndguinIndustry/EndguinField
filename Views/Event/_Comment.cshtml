@model CommentViewModel

@{
	var defaultImage = "https://static.zerochan.net/Endministrator.%28Female%29.1024.4086419.webp";
	var userName = Model.Sender?.Name ?? "Unknown User";
	var userImage = Model.Sender?.Image ?? defaultImage;
	var content = Model.Content ?? "";
	var commentId = Model.Id ?? "";
}

<div id="@commentId" class="comment-item">
	<img class="avatar" src="@userImage" alt="@userName" />
	<div class="comment-content">
		<h5 class="comment-author">@userName</h5>
        @if (!string.IsNullOrEmpty(Model.RepliedMessageId))
        {
            <div tabindex="0" class="replied-reference replied-reference-btn" data-target-id="@Model.RepliedMessageId">
                 <img src="~/assets/icons/reply.svg" alt="Reply" class="icon-secondary" asp-append-version="true" />
                 <span class="replied-reference-text"></span>
            </div>
        }
		<p class="comment-text">@content</p>
		<button type="button" class="reply-btn">
			<img src="~/assets/icons/reply.svg" alt="Reply" class="icon-secondary" asp-append-version="true" />
			<span>Reply</span>
		</button>
	</div>
</div>