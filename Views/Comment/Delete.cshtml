@model EndguinField.Models.Comment

@{
    ViewData["Title"] = "Delete Comment";
}

<div class="container mt-4">
    <h2>Delete Comment</h2>

    <div class="alert alert-warning">Are you sure you want to delete this comment?</div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-2"><strong>Id:</strong> <small class="text-muted">@Model?.Id</small></div>
            <div class="mb-2"><strong>Content:</strong>
                <div>@Model?.Content</div>
            </div>
            <div class="mb-2"><strong>SenderId:</strong> @Model?.SenderId</div>
            <div class="mb-2"><strong>TimeStamp:</strong> @Model?.TimeStamp.ToLocalTime().ToString("g")</div>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model?.Id" method="post">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>